# Multi-stage build for the arca-lb agent.
# The image includes vtysh; VPP and FRR runtimes are provided by the node.

FROM golang:1.26.4-alpine AS builder

RUN apk add --no-cache ca-certificates gcc git musl-dev

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG TARGETOS
ARG TARGETARCH

RUN if [ -n "$TARGETOS" ]; then export GOOS="$TARGETOS"; fi; \
    if [ -n "$TARGETARCH" ]; then export GOARCH="$TARGETARCH"; fi; \
    CGO_ENABLED=1 go build \
    -trimpath \
    -ldflags="-w -s" \
    -o /build/bin/arcalb-agent \
    ./cmd/arcalb-agent

FROM alpine:3.23

RUN apk add --no-cache ca-certificates frr iputils tzdata

WORKDIR /app

COPY --from=builder /build/bin/arcalb-agent /app/arcalb-agent

RUN mkdir -p /etc/arca-lb /run/vpp /var/lib/arca-lb

EXPOSE 9090

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:9090/health || exit 1

# Agent configuration is environment-specific. Mount a config file and pass
# --config=/path/to/agent.yaml, or set ARCA_AGENT_CONFIG at runtime.

ENTRYPOINT ["/app/arcalb-agent"]
