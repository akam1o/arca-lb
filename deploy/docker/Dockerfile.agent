# Multi-stage build for the arca-lb agent.
# The agent expects VPP and FRR runtime sockets/daemons to be provided by the node.

FROM golang:1.25-alpine AS builder

RUN apk add --no-cache ca-certificates gcc git musl-dev

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG TARGETOS
ARG TARGETARCH

RUN if [ -n "$TARGETOS" ]; then export GOOS="$TARGETOS"; fi; \
    if [ -n "$TARGETARCH" ]; then export GOARCH="$TARGETARCH"; fi; \
    CGO_ENABLED=1 go build \
    -trimpath \
    -ldflags="-w -s" \
    -o /build/bin/arcalb-agent \
    ./cmd/agent

FROM alpine:3.19

RUN apk add --no-cache ca-certificates frr iputils tzdata

WORKDIR /app

COPY --from=builder /build/bin/arcalb-agent /app/arcalb-agent
COPY --from=builder /build/deploy/config/agent.example.yaml /app/config/agent.example.yaml

RUN mkdir -p /run/vpp /var/lib/arca-lb

EXPOSE 9090

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:9090/health || exit 1

ENV ARCA_AGENT_CONFIG=/app/config/agent.yaml

ENTRYPOINT ["/app/arcalb-agent"]
