# Multi-stage build for arcalb-controller
# Stage 1: Build
FROM golang:1.25-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git make

# Set working directory
WORKDIR /build

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the controller binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-w -s" \
    -o /build/bin/arcalb-controller \
    ./cmd/arcalb-controller

# Stage 2: Runtime
FROM alpine:3.19

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata

# Create non-root user
RUN addgroup -g 1000 arcalb && \
    adduser -D -u 1000 -G arcalb arcalb

# Set working directory
WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/bin/arcalb-controller /app/arcalb-controller

# Copy configuration example (optional)
COPY --from=builder /build/deploy/config/controller.example.yaml /app/config/controller.example.yaml

# Change ownership
RUN chown -R arcalb:arcalb /app

# Switch to non-root user
USER arcalb

# Expose ports
EXPOSE 8080 50051

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/healthz || exit 1

# Run the controller
ENTRYPOINT ["/app/arcalb-controller"]
CMD ["--config", "/app/config/controller.yaml"]
