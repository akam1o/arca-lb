# Multi-stage build for the arca-lb operator.
FROM golang:1.27.1-alpine AS builder

RUN apk add --no-cache ca-certificates git

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG TARGETOS
ARG TARGETARCH

RUN if [ -n "$TARGETOS" ]; then export GOOS="$TARGETOS"; fi; \
    if [ -n "$TARGETARCH" ]; then export GOARCH="$TARGETARCH"; fi; \
    CGO_ENABLED=0 go build \
    -trimpath \
    -ldflags="-w -s" \
    -o /build/bin/arcalb-operator \
    ./cmd/operator

FROM alpine:3.23

RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -g 1000 arcalb && \
    adduser -D -u 1000 -G arcalb arcalb

WORKDIR /app

COPY --from=builder /build/bin/arcalb-operator /app/arcalb-operator

RUN chown -R arcalb:arcalb /app

USER arcalb

EXPOSE 8080 8081 9443

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:8081/healthz || exit 1

ENTRYPOINT ["/app/arcalb-operator"]
